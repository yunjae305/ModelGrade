# 인증값 — 실제 값은 저장소·배포 ZIP 에 넣지 않는다. 키 목록은 .env.example
.env
.env.*
!.env.example

# Python 생성물
__pycache__/
*.pyc
.pytest_cache/

# OS 생성물
.DS_Store
Thumbs.db

# Local inputs, evaluation results, registries and backups
# Public examples belong in examples/, not in data/.
/data/
/results/
/backups/
*.log
# 평가 결과 폴더의 답변 수집 로그는 git 에 올린다 (사용자 10-22)
!/참고자료/결과/**/*.log
*.sqlite3
*.sqlite3-*

# Local workspace and Python environments
/.codex/
# Claude 앱 설정 · 작업 폴더(worktrees) — 10-22
/.claude/
.venv/
venv/

# Project-local Codex runtime (version is pinned in package-lock.json)
.runtime/codex/node_modules/
node_modules/

# Codex 리뷰가 남기는 임시 폴더
.tmp-review-*/

# 회의록 원문은 공개 저장소에 올리지 않는다 (사용자 10-25 밤) — 이 PC 에만 둔다
/참고자료/분석/회의록_*
