# 키 이름만 적는 파일이다. 실제 값은 같은 폴더의 .env 에 넣는다.
# .env 는 저장소·배포 ZIP 에 넣지 않는다 (.gitignore). 값을 채팅·문서·로그에 붙여 넣지 않는다.
# 아래 키는 코드가 실제로 읽는 이름만 적었다.

# 비교 답변 수집 — python run.py 시작 시 읽음. 화면 변경은 해당 서버 세션에만 적용.
# 키와 모델 ID가 모두 있어야 등록된다. 등록만으로 API를 호출하지 않는다.
# 2026-10-07 확인한 일반 텍스트 표준 API의 저가 모델 (가격·접근 권한은 제공자에서 확인).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# GPT-5 nano 종료 예정: 2026-12-11. 다른 모델로 자동 대체하지 않는다.
OPENAI_MODEL=gpt-6-luna
# 모델별로 동시에 수집할 독립 질문·대화 수(1~4). 같은 대화 안의 턴은 항상 순서대로 요청.
# 기본 3: 제공자 3개 합계 최대 9요청. 429/동시 호출 제한이 있으면 1로 낮춘 뒤 서버 재시작.
COMPARISON_COLLECTION_WORKERS=3

# Jev 의미 평가(J1~J6) — code_eval/jev_client.py
# 키가 없으면 Jev 단계만 NOT_CONFIGURED 로 기록하고 CODE 평가는 그대로 끝난다.
TYPESAFE_API_KEY=
# 비워 두면 https://api.typesafe.ai/v1
TYPESAFE_API_BASE=
# 비워 두면 jev-latest (버전을 고정하려면 예: jev-1.13.0)
JEV_MODEL=

# 의미 평가 엔진 — anthropic_api | auto | openai_api | jev | claude_cli | codex_cli
# auto: SEMANTIC_API_KEY가 있으면 OpenAI 평가 API, 없으면 Codex CLI. API 오류 시 CLI로 자동 대체하지 않음.
# CLI 에서는 --semantic-engine codex-cli 로 선택. CLI 로그인 상태 사용, 응답 수집용 GPT API 키와 별개.
SEMANTIC_ENGINE=openai_api
# Claude API 의미 평가: 기존 ANTHROPIC_API_KEY 재사용. 수집 모델과 별도로 평가 모델·effort를 고정.
SEMANTIC_ANTHROPIC_MODEL=claude-sonnet-5-5
SEMANTIC_ANTHROPIC_EFFORT=medium
SEMANTIC_ANTHROPIC_BASE=https://api.anthropic.com/v1
SEMANTIC_ANTHROPIC_TIMEOUT=180
SEMANTIC_ANTHROPIC_MAX_OUTPUT_TOKENS=12000
SEMANTIC_ANTHROPIC_MAX_SEARCHES=4
SEMANTIC_ANTHROPIC_MAX_FETCHES=8
# pause_turn 정상 이어가기만 허용. 오류 재시도/CLI 대체 없음. 문항별 검색·원문 한도는 이어가도 유지.
SEMANTIC_ANTHROPIC_MAX_CONTINUATIONS=2
# 현재 OpenAI 의미 평가: 아래 평가용 키를 명시적으로 등록.
# OPENAI_API_KEY(답변 수집)로 자동 대체하지 않으며 같은 계정을 쓸 때도 별도 지정.
SEMANTIC_API_KEY=
SEMANTIC_API_MODEL=gpt-6.1-sol
SEMANTIC_API_BASE=https://api.openai.com/v1
SEMANTIC_API_REASONING=medium
SEMANTIC_API_TIMEOUT=180
SEMANTIC_API_MAX_OUTPUT_TOKENS=12000
# 0 또는 빈 값은 앱의 검색·페이지 열기 호출 한도 없음. API 제공자 자체 제한·시간·토큰 제한은 유지.
SEMANTIC_API_MAX_TOOL_CALLS=0
# 완료된 J5 보류만 한 번 추가 검증. HTTP 오류 재시도나 다른 기준 재평가는 하지 않음.
# 0이면 비활성. 추가 API 제한 시간은 별도이며 출처 원문 대조 한도는 기존대로 적용.
SEMANTIC_API_EVIDENCE_RECOVERY_ROUNDS=1
SEMANTIC_API_EVIDENCE_RECOVERY_TIMEOUT=120
SEMANTIC_API_EVIDENCE_RECOVERY_MAX_TOOL_CALLS=0
# J5에 참조 자료가 없을 때 검색. 추가 검증 후에도 근거가 부족하면 검증 기준 미충족 FAIL.
SEMANTIC_WEB_SEARCH=live
# 비교 실행의 의미 평가 동시 호출 상한(4~16). 기본 12는 네 모델에 3개씩 배분.
# 설정을 생략해도 코드 기본값은 12. 429/동시 호출 제한이 있으면 8로 낮춘 뒤 서버 재시작.
# 평가 원문·모델·기준·전체 호출 수는 바뀌지 않습니다.
COMPARISON_SEMANTIC_WORKERS=12
# codex_cli 일 때: 비우면 gpt-6.1-sol / high / PATH의 codex / 제한 시간 600초
CODEX_CLI_MODEL=gpt-6.1-sol
CODEX_CLI_REASONING=high
CODEX_CLI_PATH=
CODEX_CLI_TIMEOUT=600
# claude_cli 일 때만: 비우면 Claude CLI 기본 모델 / PATH 의 claude
CLAUDE_CLI_MODEL=
CLAUDE_CLI_PATH=

# LLM Judge 직접 API 호출 — evaluator/judge/client.py
# 키가 없으면 JUDGE_MODEL_ACCESS_REQUIRED 로 멈춘다. 빈 값은 없는 것으로 본다.
JUDGE_API_KEY=
# 비워 두면 https://api.openai.com/v1
JUDGE_API_BASE=
# 비워 두면 gpt-5.6-sol
JUDGE_MODEL=
