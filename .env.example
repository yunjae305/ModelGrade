# 키 이름만 적는 파일이다. 실제 값은 같은 폴더의 .env 에 넣는다.
# .env 는 저장소·배포 ZIP 에 넣지 않는다 (.gitignore). 값을 채팅·문서·로그에 붙여 넣지 않는다.
# .env 를 바꾸면 서버를 다시 시작해야 적용된다.

# 비교 답변 수집 — python run.py 시작 시 읽음. 키와 모델 ID가 모두 있어야 등록된다.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# FactChat API Gateway (선택) — OpenAI 호환 Chat Completions. 모델 ID 는 게이트웨이 모델 목록의 이름(예: claude-sonnet-5).
# 주소는 https://api.factchat.ai/v1 (기본) 또는 https://factchat-cloud.mindlogic.ai/v1/gateway 만 허용.
FACTCHAT_API_KEY=
FACTCHAT_MODEL=
FACTCHAT_BASE_URL=
# 업로드 직후 자동 수집의 허용 제공자·단가·호출·비용 한도는 화면의 '연결·수집 설정'에서 정하며 data/auto_collection_policy.json 에 저장된다 (키 없음).
# 모델별로 동시에 수집할 독립 질문·대화 수(1~4, 기본 3). 같은 대화의 턴은 항상 순서대로 요청.
COMPARISON_COLLECTION_WORKERS=3

# 의미 평가(J1~J6) 엔진 — anthropic_api | openai_api
SEMANTIC_ENGINE=anthropic_api
# J5 사실 확인용 웹검색 (live | disabled)
SEMANTIC_WEB_SEARCH=live
# 의미 평가 방식 — legacy(기준 6개를 한 번에 묻기, 기본) | items(세부 기준 25·점검 항목 39에 예/아니오+인용으로 답하고 서버가 인용 검증·집계)
SEMANTIC_PIPELINE=legacy
# 의미 평가 동시 호출 상한(4~16, 기본 12). 429가 나면 8로 낮춘 뒤 서버 재시작.
COMPARISON_SEMANTIC_WORKERS=12
# 호출 방식 — batch(권장: Claude Message Batches 에 묶어 제출하고 폴링, 평가 비용 절반·결과는 보통 1시간 안. Claude API 평가자만)
#           | realtime(질문마다 바로 호출, 값이 없을 때 기본)
SEMANTIC_DISPATCH=batch

# Claude API 평가 (SEMANTIC_ENGINE=anthropic_api) — 키는 위 ANTHROPIC_API_KEY를 함께 사용
SEMANTIC_ANTHROPIC_MODEL=claude-opus-5-5
SEMANTIC_ANTHROPIC_EFFORT=high
SEMANTIC_ANTHROPIC_BASE=https://api.anthropic.com/v1
SEMANTIC_ANTHROPIC_TIMEOUT=180
SEMANTIC_ANTHROPIC_MAX_OUTPUT_TOKENS=20000
SEMANTIC_ANTHROPIC_MAX_SEARCHES=1
SEMANTIC_ANTHROPIC_MAX_FETCHES=8
SEMANTIC_ANTHROPIC_MAX_CONTINUATIONS=2
# SEMANTIC_DISPATCH=batch 일 때 — 묶음 하나의 질문 수(1~1000, 기본 20), 묶음 상태 조회 주기(초, 기본 15)
SEMANTIC_ANTHROPIC_BATCH_QUESTIONS=20
SEMANTIC_ANTHROPIC_BATCH_POLL_SECONDS=15
# 고정 지시문(도구·시스템·평가 규칙) 프롬프트 캐시. on(기본)/off — 판정 문장은 같고 캐시 읽기 단가만 다름
SEMANTIC_ANTHROPIC_PROMPT_CACHE=on

# OpenAI API 평가 (SEMANTIC_ENGINE=openai_api) — 답변 수집용 OPENAI_API_KEY와 별도로 지정
SEMANTIC_API_KEY=
SEMANTIC_API_MODEL=gpt-6.1-sol
SEMANTIC_API_BASE=https://api.openai.com/v1
SEMANTIC_API_REASONING=medium
SEMANTIC_API_TIMEOUT=180
SEMANTIC_API_MAX_OUTPUT_TOKENS=12000
# 0 또는 빈 값은 앱의 검색·페이지 열기 호출 한도 없음
SEMANTIC_API_MAX_TOOL_CALLS=0
# 미확인 J5 근거만 한 번 추가 검증 (0이면 끔)
SEMANTIC_API_EVIDENCE_RECOVERY_ROUNDS=1
SEMANTIC_API_EVIDENCE_RECOVERY_TIMEOUT=120
SEMANTIC_API_EVIDENCE_RECOVERY_MAX_TOOL_CALLS=0

# AIONA 웹 자동 수집 — 로그인이 풀렸을 때 프로그램이 다시 로그인하는 데 쓴다 (값은 사용자가 직접 넣음, 저장소에 올리지 않음)
AIONA_LOGIN_ID=
AIONA_LOGIN_PASSWORD=
