# aiona-chat-eval(옛 이름 ModelGrade) 설정 예시 — 이 파일을 .env 로 복사해 값을 채운다.
#   설치 스크립트가 .env 를 만들어 주고, `aiona-chat-eval setup` 이 필수 · 권장 키를 하나씩 물어 넣어 준다(값은 화면에 남지 않음).
#   · .env 는 git · 배포에 올라가지 않는다(.gitignore). 값을 채팅 · 문서 · 로그에 붙여 넣지 않는다.
#   · 명령을 실행할 때마다 읽는다 — 바꾸면 다음 실행부터. 비워 둔 줄은 기본값. 따옴표는 필요 없다.
#   · 점검: `aiona-chat-eval doctor` (값은 출력하지 않고 있음 · 없음만)

# ═══ 1. 필수 — 이것만 채우면 수집 → 판정 → 보고서가 돈다 ═══════════════════════════════════════════════════
# OpenAI API 키 — 1차 심판(Decisions)과 질문 생성기. https://platform.openai.com/api-keys 에서 만든 키(sk-…)
OPENAI_API_KEY=

# ═══ 2. 로그인 — 키가 아니라 명령으로 한다 (여기에 적을 값 없음) ═══════════════════════════════════════════
#   · Codex CLI (2차 심판, 필수)        : codex login        — ChatGPT 계정. `aiona-chat-eval setup` 이 대신 띄운다
#   · Claude CLI (기준 다듬기 루프, 선택): claude auth login  — Claude 계정
#   · ChatGPT · Claude · Gemini 웹 (답변 수집): aiona-chat-eval login — 수집용 Chrome 창에서 한 번 로그인하면 그 프로필에 남는다
#   · AIONA 웹 (답변 수집): 아래 AIONA_LOGIN_ID · AIONA_LOGIN_PASSWORD 를 넣으면 수집기가 로그인한다(없으면 창에서 직접)

# ═══ 3. 권장 ═══════════════════════════════════════════════════════════════════════════════════════════════
# Jev(TypeSafe) API 키 — 작은 질문(3만 2천 토큰 이하 · 첨부 없음)의 1차 심판. 비우면 Decisions 가 모든 질문을 판정
TYPESAFE_API_KEY=
# AIONA 계정 — 로그인이 풀리면 수집기가 다시 로그인('자동 로그인 30일'을 켬)
AIONA_LOGIN_ID=
AIONA_LOGIN_PASSWORD=

# ═══ 4. 선택 — 답변 수집 환경 (비우면 기본값) ══════════════════════════════════════════════════════════════
# AIONA 웹 주소 — 비우면 코드 기본값(개발 서버). 다른 서버 · 공개 서버로 받을 때만
AIONA_URL=
# AIONA 로그인이 풀렸을 때 자동으로 다시 로그인할지 — 1(기본) · 0
AIONA_AUTO_LOGIN=
# Chrome 실행 파일 — 비우면 Windows · macOS 기본 설치 위치 또는 PATH 에서 찾음
CHROME_PATH=
# 수집용 Chrome 디버깅 포트 — 비우면 9222
CHROME_CDP_PORT=

# ═══ 5. 선택 — 심판 모델 · CLI 경로 (보통 그대로) ═══════════════════════════════════════════════════════════
# 1차 심판 Decisions — 키는 OPENAI_API_KEY 를 쓴다(따로 두려면 DECISIONS_API_KEY). 끄려면 DECISIONS_FALLBACK=0
DECISIONS_API_KEY=
DECISIONS_MODEL=gpt-6-luna
DECISIONS_API_BASE=https://api.openai.com/v1
DECISIONS_FALLBACK=1
# 1차 심판 Jev 판 — 같은 답이면 같은 판정이 되게 고정(10-26)
JEV_MODEL=jev-1.14.0
# 2차 심판 Codex CLI — 경로를 따로 줄 때만 CODEX_CLI_PATH. 추론 수준 low 유지(10-21)
CODEX_CLI_PATH=
CODEX_CLI_MODEL=gpt-6-luna
CODEX_CLI_REASONING=low
# 기준 다듬기 루프(harness2) · 심판 비교용 Claude CLI — 경로 · 모델을 따로 줄 때만
CLAUDE_CLI_PATH=
CLAUDE_CLI_MODEL=
# 질문 생성기 모델 (키는 OPENAI_API_KEY)
OPENAI_MODEL=gpt-6-luna

# ═══ 6. 선택 — 판정 흐름 조정 (시험할 때만 바꿈) ═══════════════════════════════════════════════════════════
# 1차 심판 흐름 — stances(기본: 크기로 Jev 또는 Decisions, 판정 프롬프트 3종 가중 다수결) · situational · auto
FIRST_JUDGE_MODE=stances
# 판정 프롬프트 3종(태도 글 · 가중치) 파일 — 비우면 참고자료/프롬프트/1차심판_프롬프트3종.json
FIRST_JUDGE_STANCES=
# Codex 로 넘기는 조건 — 1차의 FAIL 확률이 이 값 이상이거나 확신이 이 값 미만
SCREEN_FAIL_PROB=0.3
SCREEN_CONFIDENT=0.7
# 1차가 '해당 없음'이고 FAIL 확률이 낮으면 확신이 낮아도 Codex 에 안 보냄 — 1(기본) · 0
SCREEN_SKIP_NA_LOWCONF=1
# 1차의 FAIL 확률이 이 값 이상이면 '강한 FAIL' 로 기록만(확정은 Codex)
SECOND_JUDGE_CONFIDENT=0.7
# Codex 한 번에 묶는 단일 질문 수 · 묶음 하나의 글자 합 상한
CODEX_BATCH=10
CODEX_BATCH_CHARS=400000

# ═══ 7. 선택 — 다른 AI 서비스 · 질문 세트 만들기 ══════════════════════════════════════════════════════════
# FactChat 웹(aichat.kku.ac.kr, 건국대 통합로그인) — 첫 로그인: python tools/web_chat_login.py factchat --auto --inspect
FACTCHAT_LOGIN_ID=
FACTCHAT_LOGIN_PASSWORD=
# 우수AI 웹(app.oosoo.kr) — 첫 로그인: python tools/web_chat_login.py oosoo --auto --inspect
OOSOO_LOGIN_ID=
OOSOO_LOGIN_PASSWORD=
# 질문 세트 첨부 PDF 의 한글 글꼴(.ttf 경로) — 비우면 시스템 글꼴에서 찾음
QUESTION_FONT=

# ═══ 8. 옛 기능 — 지금 흐름(aiona-chat-eval start)에서는 쓰지 않음 ═══════════════════════════════════════════════
# 옛 웹 UI(SERVICE_UI) · `python -m code_eval` 의 의미 평가 엔진(Claude API · OpenAI API) 설정. 그 기능을 쓸 때만 채운다.
ANTHROPIC_API_KEY=
# 엔진 — anthropic_api | openai_api · J5 사실 확인 웹검색 — live | disabled
SEMANTIC_ENGINE=anthropic_api
SEMANTIC_WEB_SEARCH=live
# 방식 — legacy(기준을 한 번에) | items(세부 기준 · 점검 항목) · 호출 — batch(Claude Message Batches) | realtime
SEMANTIC_PIPELINE=legacy
SEMANTIC_DISPATCH=batch
SEMANTIC_ANTHROPIC_MODEL=claude-opus-5-5
SEMANTIC_ANTHROPIC_EFFORT=high
SEMANTIC_ANTHROPIC_BASE=https://api.anthropic.com/v1
SEMANTIC_ANTHROPIC_TIMEOUT=180
SEMANTIC_ANTHROPIC_MAX_OUTPUT_TOKENS=20000
SEMANTIC_ANTHROPIC_MAX_SEARCHES=1
SEMANTIC_ANTHROPIC_MAX_FETCHES=8
SEMANTIC_ANTHROPIC_MAX_CONTINUATIONS=2
SEMANTIC_ANTHROPIC_BATCH_QUESTIONS=20
SEMANTIC_ANTHROPIC_BATCH_POLL_SECONDS=15
SEMANTIC_ANTHROPIC_PROMPT_CACHE=on
SEMANTIC_API_KEY=
SEMANTIC_API_MODEL=gpt-6.1-sol
SEMANTIC_API_BASE=https://api.openai.com/v1
SEMANTIC_API_REASONING=medium
SEMANTIC_API_TIMEOUT=180
SEMANTIC_API_MAX_OUTPUT_TOKENS=12000
SEMANTIC_API_MAX_TOOL_CALLS=0
SEMANTIC_API_EVIDENCE_RECOVERY_ROUNDS=1
SEMANTIC_API_EVIDENCE_RECOVERY_TIMEOUT=120
SEMANTIC_API_EVIDENCE_RECOVERY_MAX_TOOL_CALLS=0
